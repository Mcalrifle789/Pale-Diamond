# Copy to .env for local backend testing (gitignored — NEVER commit).
# In production these live in Vercel -> Settings -> Environment Variables.

# The private Pale Diamond OpenRouter key (required for real AI + images)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Live Stripe secret key (checkout); prices are auto-provisioned on first use
STRIPE_SECRET_KEY=sk_live_your-key-here

# The deployed site origin (redirects + referer)
PUBLIC_URL=https://mcalrifle789.github.io/Pale-Diamond

# --- Database (pick ONE) -----------------------------------------------------
# Neon cloud Postgres — create a database at neon.tech, paste the pooled
# connection string here and accounts/subscriptions persist server-side.
# DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/pale-diamond?sslmode=require

# SQLite location — leave unset to auto-place the database on the first
# writable external/secondary drive (e.g. D:\PaleDiamondData\pale_diamond.db).
# PD_DB_PATH=D:\PaleDiamondData\pale_diamond.db